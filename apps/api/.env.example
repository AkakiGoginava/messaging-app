# Copy this file to `.env` in `apps/api` before running Prisma or the API
# locally. The values below match the root `docker-compose.yml` defaults and
# are local-development-only placeholders, not real credentials.

DATABASE_URL="postgresql://messaging_app:local_dev_only@localhost:5432/messaging_app?schema=public"
# Distinct from the web app's default port 3000 so both can run at once.
PORT=3001

# Signs the session cookie. The API refuses to start without it — there is no
# built-in fallback, so a deployment cannot silently run with a publicly known
# key. Generate a fresh, long, random value per environment, for example:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is for local development only. Never commit a real
# secret to this repository.
SESSION_SECRET="local_dev_only_replace_me"

# Number of trusted reverse-proxy hops in front of this service. Leave it
# UNSET (as it is here) for local development and CI. Unset means forwarded
# headers are ignored: `req.ip` is the socket address, so no caller can pick
# its own rate-limit bucket.
#
# DO NOT SET THIS UNLESS A TRUSTED EDGE SITS IN FRONT OF NEXT.JS.
#
# Setting it with only the Next.js `/api/*` proxy in front does not merely
# fail to help — it removes rate limiting altogether. Next forwards a
# client-supplied `X-Forwarded-For` verbatim and never appends the address it
# observed, so `req.ip` becomes whatever the caller wrote and a caller that
# varies it gets a fresh bucket every request. This was measured end to end:
# 15 consecutive requests against a limit of 10 all succeeded.
#
# It is safe only behind an edge that OVERWRITES or APPENDS the client
# address — nginx `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for`,
# a cloud load balancer, or a platform router. The value must equal the number
# of such hops; overstating it re-opens the same bypass. Nothing in the code
# can detect the mistake, because a forged header looks like a genuine one.
#
# Setting it also lets `express-session` believe `X-Forwarded-Proto` when
# deciding to send a `Secure` cookie. Until it is set, a production
# deployment behind TLS termination sends no session cookie at all and
# authentication fails visibly — that is the intended signal, not a bug.
#
# Accepted values: a whole number, 1 or greater. `0`, `true`, `false`, and
# anything non-numeric are rejected at boot rather than defaulted.
# TRUST_PROXY_HOPS=1
