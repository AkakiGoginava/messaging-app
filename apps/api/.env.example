# Copy this file to `.env` in `apps/api` before running Prisma or the API
# locally. The values below match the root `docker-compose.yml` defaults and
# are local-development-only placeholders, not real credentials.

DATABASE_URL="postgresql://messaging_app:local_dev_only@localhost:5432/messaging_app?schema=public"
# Distinct from the web app's default port 3000 so both can run at once.
PORT=3001

# Signs the session cookie. The API refuses to start without it — there is no
# built-in fallback, so a deployment cannot silently run with a publicly known
# key. Generate a fresh, long, random value per environment, for example:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is for local development only. Never commit a real
# secret to this repository.
SESSION_SECRET="local_dev_only_replace_me"
