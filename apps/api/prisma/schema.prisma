// Prisma schema for the messaging application API.
//
// MA-2 (project enablement) owned only Prisma tooling, PostgreSQL
// connectivity, and the infrastructure-only baseline migration. MA-3 (auth
// vertical slice) adds the first product entities: `User` and the
// PostgreSQL-backed session store. The remaining entities
// (`Conversation`, `ConversationMember`, `Message`) are added by their
// owning vertical-slice stories.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered account. Passwords are only ever persisted as an Argon2id
/// hash; the plaintext never leaves the request that created it.
///
/// `email` is stored normalized to lowercase so that duplicate-account
/// detection cannot be bypassed by changing capitalization. `username` is
/// stored exactly as entered and is unique by exact match.
model User {
  // Server-generated through `pgcrypto`, enabled by the MA-2 baseline
  // migration specifically for this purpose.
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// Server-side session records written by `express-session` through
/// `connect-pg-simple`. The shape (`sid`, `sess`, `expire`) and the
/// `IDX_session_expire` index name are dictated by that store.
///
/// The table is owned by this migration rather than by the store's
/// `createTableIfMissing` option so that `prisma migrate deploy` fully
/// provisions a clean database and the schema stays reviewable.
model Session {
  sid    String   @id
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
